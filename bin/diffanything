#!/bin/sh
# Launch Neovim straight into diffanything.
#   diffanything            prompt for A, then B
#   diffanything A          prompt for B only
#   diffanything A B        diff immediately
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd) || exit 1
rtp=$(printf '%s' "$root" | sed 's/[\\ ,]/\\&/g')

if [ "$#" -gt 2 ]; then
  echo "usage: diffanything [path-a] [path-b]" >&2
  exit 2
fi

DIFFANYTHING_A="${1:-}" DIFFANYTHING_B="${2:-}" exec nvim \
  -c 'let g:diffanything_standalone = 1' \
  -c "set rtp^=$rtp" \
  -c 'runtime plugin/diffanything.lua' \
  -c 'lua require("diffanything").cli()'
